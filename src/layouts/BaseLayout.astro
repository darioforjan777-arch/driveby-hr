---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName } from '../data/site';

interface Props {
  title: string;
  description?: string;
  activeCategorySlug?: string;
}
const { title, description, activeCategorySlug } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const pageDescription = description ?? 'Praktični vodiči za vozače u Hrvatskoj — tehnički pregled, održavanje, kupnja i prodaja auta.';
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('dby-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div style="min-height:100vh; display:flex; flex-direction:column;">
      <Header activeCategorySlug={activeCategorySlug} />
      <main style="flex:1;">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
