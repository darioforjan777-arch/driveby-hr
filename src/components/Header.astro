---
import { siteName, categories } from '../data/site';

interface Props {
  activeCategorySlug?: string;
}
const { activeCategorySlug } = Astro.props;
---

<header class="dby-header" style="position:sticky; top:0; z-index:40; background:var(--bg-surface); border-bottom:1px solid var(--border);">
  <div class="dby-header-row" style="max-width:1280px; margin:0 auto; padding:12px 20px; display:grid; grid-template-columns:auto 1fr auto; align-items:center; gap:16px;">
    <div style="display:flex; align-items:center; gap:18px; min-width:0;">
      <a href="/" style="font-weight:800; font-size:20px; letter-spacing:-0.02em; color:var(--text); flex-shrink:0;">{siteName}<span style="color:var(--accent);">.</span></a>
      <nav class="dby-desktop" style="align-items:center; gap:4px; position:relative;">
        <button id="dby-dropdown-btn" type="button" style="display:flex; align-items:center; gap:7px; background:none; border:none; font:inherit; font-size:14px; font-weight:600; color:var(--text); padding:9px 12px; border-radius:20px; cursor:pointer;" class="link-muted-hover">
          Kategorije blogova
          <span id="dby-dropdown-arrow" style="display:inline-block; width:6px; height:6px; border-right:1.5px solid currentColor; border-bottom:1.5px solid currentColor; transform:rotate(45deg); margin-top:-2px; transition:transform 0.12s;"></span>
        </button>
        <div id="dby-dropdown" style="display:none; position:absolute; top:44px; left:0; min-width:260px; background:var(--bg-surface); border:1px solid var(--border); border-radius:12px; box-shadow:0 12px 28px rgba(0,0,0,0.12); padding:8px; gap:2px; animation:dby-slidedown 0.12s ease-out; z-index:50; grid-template-columns:1fr;">
          {categories.map((cat) => (
            <a
              href={`/kategorija/${cat.slug}/`}
              style={`display:flex; align-items:center; padding:10px 12px; border-radius:8px; font-size:14px; font-weight:${cat.slug === activeCategorySlug ? 700 : 500}; color:${cat.slug === activeCategorySlug ? 'var(--accent)' : 'var(--text)'};`}
              class="link-muted-hover"
            >
              {cat.name}
            </a>
          ))}
        </div>
      </nav>
    </div>
    <div></div>
    <div style="display:flex; align-items:center; gap:10px; justify-self:end;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span id="dby-theme-label" style="font-size:12.5px; font-weight:600; color:var(--text-muted); white-space:nowrap;">Svijetlo</span>
        <button id="dby-theme-toggle" type="button" aria-label="Promijeni temu" style="width:44px; height:26px; border-radius:14px; border:1px solid var(--border); background:var(--bg-surface-2); position:relative; cursor:pointer; padding:0; flex-shrink:0;">
          <span id="dby-theme-knob" style="position:absolute; top:2px; left:2px; width:20px; height:20px; border-radius:50%; background:var(--accent); transition:left 0.15s ease;"></span>
        </button>
      </div>
      <button id="dby-menu-toggle" type="button" aria-label="Izbornik" class="dby-mobile-menu-btn" style="display:none; flex-direction:column; align-items:center; gap:4px; background:none; border:none; cursor:pointer; padding:0; flex-shrink:0;">
        <span style="width:40px; height:40px; display:flex; align-items:center; justify-content:center; border:1px solid var(--border); border-radius:8px;">
          <span style="display:block; width:18px; height:1.5px; background:var(--text); position:relative;">
            <span style="position:absolute; left:0; top:-6px; width:18px; height:1.5px; background:var(--text);"></span>
            <span style="position:absolute; left:0; top:6px; width:18px; height:1.5px; background:var(--text);"></span>
          </span>
        </span>
        <span style="font-size:9.5px; font-weight:700; color:var(--text-muted); line-height:1;">Meni</span>
      </button>
    </div>
  </div>
  <div id="dby-mobile-menu" style="display:none; position:fixed; inset:0; z-index:100; background:var(--bg-surface); flex-direction:column; padding:16px 20px 24px; overflow-y:auto;">
    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
      <span style="font-weight:800; font-size:19px;">{siteName}<span style="color:var(--accent);">.</span></span>
      <button id="dby-menu-close" type="button" aria-label="Zatvori izbornik" style="width:38px; height:38px; display:flex; align-items:center; justify-content:center; background:none; border:1px solid var(--border); border-radius:8px; cursor:pointer; font-size:18px; color:var(--text);">✕</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:2px;">
      <div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); padding:6px 4px;">Kategorije blogova</div>
      {categories.map((cat) => (
        <a
          href={`/kategorija/${cat.slug}/`}
          style={`display:flex; align-items:center; padding:12px 14px; margin-top:6px; border-radius:10px; font-size:15px; font-weight:600; background:${cat.slug === activeCategorySlug ? 'var(--accent)' : 'var(--bg-surface-2)'}; color:${cat.slug === activeCategorySlug ? '#fff' : 'var(--text)'}; border:1px solid ${cat.slug === activeCategorySlug ? 'var(--accent)' : 'var(--border)'};`}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .dby-mobile-menu-btn {
    display: none;
  }
  @media (max-width: 680px) {
    .dby-mobile-menu-btn {
      display: flex !important;
    }
  }
</style>

<script>
  function initHeader() {
    const dropdownBtn = document.getElementById('dby-dropdown-btn');
    const dropdown = document.getElementById('dby-dropdown');
    const dropdownArrow = document.getElementById('dby-dropdown-arrow');
    let dropdownOpen = false;
    dropdownBtn?.addEventListener('click', () => {
      dropdownOpen = !dropdownOpen;
      if (dropdown) dropdown.style.display = dropdownOpen ? 'grid' : 'none';
      if (dropdownArrow) dropdownArrow.style.transform = dropdownOpen ? 'rotate(225deg)' : 'rotate(45deg)';
    });
    document.addEventListener('click', (e) => {
      if (dropdownOpen && dropdown && dropdownBtn && !dropdown.contains(e.target as Node) && !dropdownBtn.contains(e.target as Node)) {
        dropdownOpen = false;
        dropdown.style.display = 'none';
        if (dropdownArrow) dropdownArrow.style.transform = 'rotate(45deg)';
      }
    });

    const menuBtn = document.getElementById('dby-menu-toggle');
    const menuClose = document.getElementById('dby-menu-close');
    const mobileMenu = document.getElementById('dby-mobile-menu');
    function openMenu() {
      if (mobileMenu) mobileMenu.style.display = 'flex';
    }
    function closeMenu() {
      if (mobileMenu) mobileMenu.style.display = 'none';
    }
    menuBtn?.addEventListener('click', openMenu);
    menuClose?.addEventListener('click', closeMenu);

    const themeToggle = document.getElementById('dby-theme-toggle');
    const themeKnob = document.getElementById('dby-theme-knob');
    const themeLabel = document.getElementById('dby-theme-label');
    function syncKnob() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (themeKnob) themeKnob.style.left = isDark ? '21px' : '2px';
      if (themeLabel) themeLabel.textContent = isDark ? 'Tamno' : 'Svijetlo';
    }
    syncKnob();
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('dby-theme', next);
      syncKnob();
    });
  }
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
