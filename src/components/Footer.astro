---
import { siteName, categories } from '../data/site';
const year = new Date().getFullYear();
---

<footer style="background:var(--bg-surface-2); border-top:1px solid var(--border); margin-top:64px;">
  <div class="dby-footer-grid" style="max-width:1200px; margin:0 auto; padding:48px 20px 28px; display:grid; gap:32px;">
    <div>
      <div style="font-weight:800; font-size:19px; color:var(--text); margin-bottom:10px;">{siteName}<span style="color:var(--accent);">.</span></div>
      <p style="font-size:14px; color:var(--text-muted); line-height:1.6; max-width:320px; margin:0;">Praktični vodiči, iskustva i savjeti za vozače u Hrvatskoj — bez tuning žargona, bez napadnih reklama.</p>
    </div>
    <div>
      <div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:14px;">Kategorije</div>
      <div style="display:flex; flex-direction:column; gap:10px;">
        {categories.map((cat) => (
          <a href={`/kategorija/${cat.slug}/`} style="font-size:14px; color:var(--text);" class="link-hover">{cat.name}</a>
        ))}
      </div>
    </div>
    <div>
      <div style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:14px;">Stranica</div>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <a href="/o-stranici/" style="font-size:14px; color:var(--text);" class="link-hover">O stranici</a>
        <a href="/kontakt/" style="font-size:14px; color:var(--text);" class="link-hover">Kontakt</a>
        <a href="/privatnost/" style="font-size:14px; color:var(--text);" class="link-hover">Privatnost</a>
        <a href="/kolacici/" style="font-size:14px; color:var(--text);" class="link-hover">Kolačići</a>
      </div>
    </div>
  </div>
  <div style="max-width:1200px; margin:0 auto; padding:16px 20px 28px; border-top:1px solid var(--border); font-size:12.5px; color:var(--text-muted);">
    © {year} {siteName}. Sav sadržaj informativne je naravi i ne zamjenjuje stručni servisni pregled.
  </div>

  <button
    id="dby-back-to-top"
    type="button"
    aria-label="Povratak na vrh"
    title="Povratak na vrh"
    style="display:none; position:fixed; right:20px; bottom:20px; z-index:55; width:44px; height:44px; border-radius:50%; border:1px solid var(--border); background:var(--accent); color:#fff; align-items:center; justify-content:center; cursor:pointer; box-shadow:0 6px 18px rgba(0,0,0,0.18); transition:opacity 0.15s ease, transform 0.15s ease;"
  >
    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"></path><path d="M5 12l7-7 7 7"></path></svg>
  </button>

  <div id="dby-cookie-overlay" style="display:none; position:fixed; inset:0; z-index:200; background:rgba(15,15,17,0.55); backdrop-filter:blur(2px); align-items:center; justify-content:center; padding:16px;">
    <div id="dby-cookie-banner" style="width:100%; max-width:520px; max-height:88vh; overflow-y:auto; background:var(--bg-surface); border:1px solid var(--border); border-radius:16px; box-shadow:0 20px 60px rgba(0,0,0,0.25); padding:26px 26px 22px; animation:dby-cookie-modal-in 0.22s ease-out;">
      <div style="font-size:17px; font-weight:800; color:var(--text); margin-bottom:8px;">Postavke privatnosti</div>
      <p style="font-size:13.5px; color:var(--text-muted); margin:0 0 18px; line-height:1.6;">Koristimo kolačiće za osnovno funkcioniranje stranice, mjerenje posjeta i prikaz relevantnog sadržaja. Više u <a href="/kolacici/" style="color:var(--accent);">pravilima o kolačićima</a>.</p>

      <div id="dby-cookie-categories" style="display:none; flex-direction:column; gap:12px; margin:0 0 18px; padding-top:4px; border-top:1px solid var(--border); padding-top:16px;">
        <label style="display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:13.5px; color:var(--text);">
          <span style="display:flex; align-items:center; gap:7px;">Nužni<span class="dby-cookie-info" title="Nužni za osnovno funkcioniranje stranice, uvijek aktivni.">i</span></span>
          <input type="checkbox" checked disabled style="width:17px; height:17px; accent-color:var(--accent); opacity:0.7;" />
        </label>
        <label style="display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:13.5px; color:var(--text);">
          <span style="display:flex; align-items:center; gap:7px;">Funkcionalni<span class="dby-cookie-info" title="Omogućuju dodatne funkcionalnosti i personalizaciju stranice.">i</span></span>
          <input type="checkbox" id="dby-cookie-cat-functional" style="width:17px; height:17px; accent-color:var(--accent);" />
        </label>
        <label style="display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:13.5px; color:var(--text);">
          <span style="display:flex; align-items:center; gap:7px;">Statistički<span class="dby-cookie-info" title="Pomažu nam razumjeti kako posjetitelji koriste stranicu.">i</span></span>
          <input type="checkbox" id="dby-cookie-cat-statistics" style="width:17px; height:17px; accent-color:var(--accent);" />
        </label>
        <label style="display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:13.5px; color:var(--text);">
          <span style="display:flex; align-items:center; gap:7px;">Marketinški<span class="dby-cookie-info" title="Koriste se za prikaz oglasa relevantnih za vas.">i</span></span>
          <input type="checkbox" id="dby-cookie-cat-marketing" style="width:17px; height:17px; accent-color:var(--accent);" />
        </label>
      </div>

      <div style="display:flex; flex-wrap:wrap; gap:10px;">
        <button id="dby-cookie-necessary" type="button" class="dby-cookie-btn" style="flex:1; min-width:140px;">Prihvaćam nužne</button>
        <button id="dby-cookie-customize" type="button" class="dby-cookie-btn" style="flex:1; min-width:140px;">Prilagodi</button>
        <button id="dby-cookie-all" type="button" class="dby-cookie-btn" style="flex:1; min-width:140px;">Prihvaćam sve</button>
      </div>
    </div>
  </div>
</footer>

<style>
  .dby-cookie-btn {
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    padding: 11px 14px;
    border-radius: 9px;
    border: none;
    background: var(--accent);
    color: #fff;
    cursor: pointer;
  }
  .dby-cookie-btn:hover {
    filter: brightness(0.92);
  }
  .dby-cookie-info {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid var(--text-muted);
    color: var(--text-muted);
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    cursor: help;
    flex-shrink: 0;
  }
</style>

<script>
  function initCookieBanner() {
    const overlay = document.getElementById('dby-cookie-overlay');
    const banner = document.getElementById('dby-cookie-banner');
    const categoriesBox = document.getElementById('dby-cookie-categories');
    const btnNecessary = document.getElementById('dby-cookie-necessary');
    const btnCustomize = document.getElementById('dby-cookie-customize');
    const btnAll = document.getElementById('dby-cookie-all');
    const chkFunctional = document.getElementById('dby-cookie-cat-functional') as HTMLInputElement | null;
    const chkStatistics = document.getElementById('dby-cookie-cat-statistics') as HTMLInputElement | null;
    const chkMarketing = document.getElementById('dby-cookie-cat-marketing') as HTMLInputElement | null;

    function showOverlay() {
      if (!overlay) return;
      overlay.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    function hideOverlay() {
      if (!overlay) return;
      overlay.style.display = 'none';
      document.body.style.overflow = '';
    }
    function pushConsent(consent: { functional: boolean; statistics: boolean; marketing: boolean }) {
      try {
        localStorage.setItem(
          'dby-cookie-consent',
          JSON.stringify({ necessary: true, ...consent, ts: Date.now() })
        );
      } catch (e) {}
      try {
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({
          event: 'dby_cookie_consent',
          cookie_consent: { necessary: true, ...consent },
        });
      } catch (e) {}
    }

    try {
      const saved = localStorage.getItem('dby-cookie-consent');
      if (!saved) showOverlay();
    } catch (e) {
      showOverlay();
    }

    btnCustomize?.addEventListener('click', () => {
      if (!categoriesBox) return;
      const isOpen = categoriesBox.style.display === 'flex';
      categoriesBox.style.display = isOpen ? 'none' : 'flex';
      if (btnCustomize) btnCustomize.textContent = isOpen ? 'Prilagodi' : 'Spremi odabir';
      if (!isOpen) return;
      pushConsent({
        functional: !!chkFunctional?.checked,
        statistics: !!chkStatistics?.checked,
        marketing: !!chkMarketing?.checked,
      });
      hideOverlay();
    });

    btnNecessary?.addEventListener('click', () => {
      pushConsent({ functional: false, statistics: false, marketing: false });
      hideOverlay();
    });

    btnAll?.addEventListener('click', () => {
      pushConsent({ functional: true, statistics: true, marketing: true });
      hideOverlay();
    });
  }
  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);

  function initBackToTop() {
    const btn = document.getElementById('dby-back-to-top');
    if (!btn) return;
    const toggle = () => {
      btn.style.display = window.scrollY > 500 ? 'flex' : 'none';
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
  initBackToTop();
  document.addEventListener('astro:page-load', initBackToTop);
</script>
