---
import { imgBg, fmtDate } from '../data/site';
import { urlForImage } from '../lib/sanity';
import type { Article } from '../data/articles';

interface Props {
  article: Article;
  catName: string;
  hue: number;
}
const { article, catName, hue } = Astro.props;
const coverUrl = article.coverImage ? urlForImage(article.coverImage).width(800).url() : null;
---

<a href={`/clanak/${article.slug}/`} style="display:flex; flex-direction:column; border:1px solid var(--border); border-radius:14px; overflow:hidden; background:var(--bg-surface); height:100%;" class="card-hover">
  {coverUrl ? (
    <img src={coverUrl} alt={article.coverImage?.alt || article.title} width="400" height="150" loading="lazy" decoding="async" style="height:150px; width:100%; object-fit:cover; display:block;" />
  ) : (
    <div style={`height:150px; background:${imgBg(hue)}; display:flex; align-items:flex-end; padding:10px; min-width:0;`}>
      <span style="font-family:'JetBrains Mono',monospace; font-size:10.5px; color:#1c1b1a; background:rgba(255,255,255,0.85); padding:3px 7px; border-radius:5px; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:inline-block;">foto: {article.title}</span>
    </div>
  )}
  <div style="padding:16px 16px 18px; display:flex; flex-direction:column; flex:1; min-width:0;">
    <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px; min-width:0;">
      <span style="font-size:11.5px; font-weight:700; color:var(--accent); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0;">{catName}</span>
      <span class="dby-card-date" style="font-size:11.5px; color:var(--text-muted); white-space:nowrap; flex-shrink:0;">· {fmtDate(article.published)}</span>
    </div>
    <div class="dby-clamp-2" style="font-size:16px; font-weight:700; line-height:1.35; margin-bottom:8px;">{article.title}</div>
    <p class="dby-clamp-3" style="font-size:13.5px; color:var(--text-muted); line-height:1.55; margin:0 0 12px; flex:1;">{article.excerpt}</p>
    <div style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
      <span style="font-size:12.5px; color:var(--text-muted); white-space:nowrap;">{article.readMin} min čitanja</span>
      <span style="font-size:12.5px; font-weight:600; color:var(--accent); white-space:nowrap; flex-shrink:0;">Pročitaj</span>
    </div>
  </div>
</a>
