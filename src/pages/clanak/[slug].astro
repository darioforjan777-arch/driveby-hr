---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCategory, fmtDate, siteName } from '../../data/site';
import { articles, getArticleBySlug } from '../../data/articles';
import { renderArticleBody, escapeHtml } from '../../lib/portableText';
import { urlForImage } from '../../lib/sanity';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = getArticleBySlug(slug as string)!;
const cat = getCategory(article.categorySlug)!;

const seoTitle = article.seo?.metaTitle || article.title;
const seoDescription = article.seo?.metaDescription || article.excerpt;
const coverUrl = article.coverImage ? urlForImage(article.coverImage).width(1200).height(720).url() : null;

const { html: bodyHtml, toc: bodyToc } = renderArticleBody(article.body);
const toc = bodyToc
  .map((t) => ({ label: t.label, href: `#${t.id}` }))
  .concat(article.faq?.length ? [{ label: 'Često postavljana pitanja', href: '#faq' }] : []);

const related = (article.related ?? []).map((s) => getArticleBySlug(s)).filter(Boolean) as typeof articles;

const mobileTocHtml =
  toc.length > 0
    ? `<details class="dby-toc-mobile" style="margin:0 0 24px; border:1px solid var(--border); border-radius:12px; background:var(--bg-surface);">` +
      `<summary style="font-size:13.5px; font-weight:700; padding:14px 16px; cursor:pointer; list-style:none;">Sadržaj</summary>` +
      `<div style="display:flex; flex-direction:column; gap:10px; padding:0 16px 16px;">` +
      toc
        .map(
          (t) =>
            `<a href="${escapeHtml(t.href)}" style="font-size:13.5px; color:var(--text-muted); line-height:1.4; text-decoration:none;">${escapeHtml(t.label)}</a>`
        )
        .join('') +
      `</div></details>`
    : '';

const bodyHtmlWithToc =
  mobileTocHtml && bodyToc.length > 0
    ? bodyHtml.replace(`<h2 id="${bodyToc[0].id}">`, `${mobileTocHtml}<h2 id="${bodyToc[0].id}">`)
    : mobileTocHtml + bodyHtml;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';
const articleUrl = `${siteUrl}/clanak/${article.slug}/`;
const wordCount = bodyHtml
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

// Google preporuča naslovnu sliku u 3 omjera (16:9, 4:3, 1:1), svaka min. 696px širine,
// za bolju kompatibilnost s rich results-ima.
const imageObjects = article.coverImage
  ? [
      { ratio: [1200, 675] as const },
      { ratio: [1200, 900] as const },
      { ratio: [1200, 1200] as const },
    ].map(({ ratio: [w, h] }) => ({
      '@type': 'ImageObject' as const,
      url: urlForImage(article.coverImage).width(w).height(h).url(),
      width: w,
      height: h,
    }))
  : undefined;
const thumbnailUrl = article.coverImage ? urlForImage(article.coverImage).width(400).height(300).url() : undefined;
const publishedYear = article.published?.slice(0, 4);

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: seoDescription,
  image: imageObjects,
  thumbnailUrl,
  datePublished: article.published,
  dateModified: article.updated || article.published,
  author: {
    '@type': 'Organization',
    name: siteName,
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: siteName,
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  isPartOf: {
    '@type': 'WebSite',
    name: siteName,
    url: siteUrl,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  url: articleUrl,
  articleSection: cat.name,
  keywords: cat.name,
  wordCount,
  timeRequired: `PT${article.readMin}M`,
  inLanguage: 'hr',
  isAccessibleForFree: true,
  ...(publishedYear ? { copyrightYear: Number(publishedYear) } : {}),
  copyrightHolder: {
    '@type': 'Organization',
    name: siteName,
  },
};

const faqSchema =
  article.faq && article.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: article.faq.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: f.a,
          },
        })),
      }
    : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  activeCategorySlug={cat.slug}
  readingProgress
  breadcrumbs={[
    { name: 'Naslovnica', url: '/' },
    { name: cat.name, url: `/kategorija/${cat.slug}/` },
    { name: article.title, url: `/clanak/${article.slug}/` },
  ]}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <div style="max-width:1200px; margin:0 auto; padding:32px 20px 70px;">
    <div style="font-size:13px; color:var(--text-muted); margin-bottom:18px; display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
      <a href="/" aria-label="Naslovnica" title="Naslovnica" style="color:var(--text-muted); display:inline-flex; align-items:center;" class="link-hover">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V9.5Z"></path></svg>
      </a>
      <span>/</span>
      <a href={`/kategorija/${cat.slug}/`} style="color:var(--text-muted);" class="link-hover">{cat.name}</a>
    </div>

    <div class="dby-article-layout" style="display:grid; gap:44px;">
      <aside class="dby-toc" style="position:sticky; top:80px; align-self:start;">
        <div style="font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; color:var(--text-muted); margin-bottom:12px;">Sadržaj</div>
        <div style="display:flex; flex-direction:column; gap:9px;">
          {toc.map((t) => (
            <a href={t.href} style="font-size:13.5px; color:var(--text-muted); line-height:1.4;" class="link-hover">{t.label}</a>
          ))}
        </div>
      </aside>

      <article id="dby-article-content" style="min-width:0;">
        <div style="font-size:12.5px; font-weight:700; color:var(--accent); margin-bottom:10px;">{cat.name}</div>
        <h1 style="font-size:clamp(26px,4.5vw,38px); font-weight:800; letter-spacing:-0.02em; line-height:1.2; margin:0 0 14px;">{article.title}</h1>
        <div style="display:flex; flex-wrap:wrap; gap:14px; font-size:13px; color:var(--text-muted); margin-bottom:26px; border-bottom:1px solid var(--border); padding-bottom:20px;">
          <span>Objavljeno {fmtDate(article.published)}</span>
          {article.updated && <span>· Ažurirano {fmtDate(article.updated)}</span>}
          <span style="display:inline-flex; align-items:center; gap:5px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            {article.readMin} min
          </span>
        </div>

        {coverUrl && (
          <img src={coverUrl} alt={article.coverImage?.alt || article.title} width="1200" height="720" loading="eager" fetchpriority="high" decoding="async" class="dby-lightbox-img" style="width:100%; height:auto; aspect-ratio:5/3; object-fit:cover; border-radius:14px; margin-bottom:28px; cursor:zoom-in;" />
        )}

        <div class="dby-rich-text" style="line-height:1.7; margin:0 0 30px; color:var(--text);" set:html={bodyHtmlWithToc} />

        {article.faq?.length > 0 && (
        <div style="margin-bottom:36px;">
          <h2 id="faq" style="font-size:21px; font-weight:800; margin:0 0 16px; scroll-margin-top:80px;">Često postavljana pitanja</h2>
          <div style="display:flex; flex-direction:column; gap:10px;">
            {article.faq.map((f) => (
              <details style="border:1px solid var(--border); border-radius:10px; padding:14px 16px; background:var(--bg-surface);">
                <summary style="font-size:14.5px; font-weight:700; cursor:pointer;">{f.q}</summary>
                <p style="margin:10px 0 0; font-size:14px; line-height:1.6; color:var(--text-muted);">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
        )}

        <div class="dby-share-print" style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px; border:1px solid var(--border); border-radius:14px; padding:18px 20px; margin-bottom:44px;">
          <div style="display:flex; flex-wrap:wrap; align-items:center; gap:10px;">
            <span style="font-size:11.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted); margin-right:2px;">Podijeli</span>

            <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Podijeli na Facebooku" title="Facebook" style="width:36px; height:36px; border-radius:50%; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text-muted);" class="link-hover">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5h2.5l.4-3H13.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.35C16.3 4.24 15.3 4.15 14.15 4.15c-2.4 0-4.05 1.46-4.05 4.15V10.5H7.6v3h2.5V21h3.4Z"></path></svg>
            </a>
            <a href={`https://wa.me/?text=${encodeURIComponent(article.title + ' ' + articleUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Podijeli na WhatsAppu" title="WhatsApp" style="width:36px; height:36px; border-radius:50%; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text-muted);" class="link-hover">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.6 0-3.1-.4-4.5-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.7.8-.8 1-.2.2-.3.2-.5.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.2-.9.9-.9 2.2s1 2.6 1.1 2.7c.1.2 2 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"></path></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(articleUrl)}`} target="_blank" rel="noopener noreferrer" aria-label="Podijeli na LinkedInu" title="LinkedIn" style="width:36px; height:36px; border-radius:50%; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--text-muted);" class="link-hover">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21H18v-5.3c0-1.27-.02-2.9-1.77-2.9-1.78 0-2.05 1.36-2.05 2.8V21H10V9Z"></path></svg>
            </a>
            <button type="button" id="dby-share-instagram" aria-label="Podijeli na Instagramu" title="Instagram" data-url={articleUrl} style="width:36px; height:36px; border-radius:50%; border:1px solid var(--border); background:none; display:flex; align-items:center; justify-content:center; color:var(--text-muted); cursor:pointer;" class="link-hover">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="0.4" fill="currentColor" stroke="none"></circle></svg>
            </button>
            <button type="button" id="dby-copy-link" aria-label="Kopiraj link" title="Kopiraj link" data-url={articleUrl} style="width:36px; height:36px; border-radius:50%; border:1px solid var(--border); background:none; display:flex; align-items:center; justify-content:center; color:var(--text-muted); cursor:pointer;" class="link-hover">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11.5 4.5"></path><path d="M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L12.5 19.5"></path></svg>
            </button>
            <span id="dby-copy-feedback" style="display:none; font-size:12.5px; color:var(--accent); font-weight:600;">Link kopiran!</span>
          </div>

          <button type="button" id="dby-print-btn" style="display:inline-flex; align-items:center; gap:8px; font:inherit; font-size:13.5px; font-weight:600; padding:9px 16px; border-radius:10px; border:1px solid var(--border); background:var(--bg-surface); color:var(--text); cursor:pointer;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"></path><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            Ispiši / Spremi kao PDF
          </button>
        </div>

        {related.length > 0 && (
          <div>
            <h2 style="font-size:19px; font-weight:800; margin:0 0 16px;">Povezani članci</h2>
            <div class="dby-related-grid" style="display:grid; gap:20px;">
              {related.map((r) => (
                <ArticleCard article={r} catName={getCategory(r.categorySlug)!.name} hue={getCategory(r.categorySlug)!.hue} />
              ))}
            </div>
          </div>
        )}
      </article>
    </div>
  </div>

  <div
    id="dby-lightbox"
    style="display:none; position:fixed; inset:0; z-index:100; background:rgba(0,0,0,0.9); align-items:center; justify-content:center; padding:24px;"
  >
    <button
      type="button"
      id="dby-lightbox-close"
      aria-label="Zatvori"
      style="position:absolute; top:16px; right:16px; width:40px; height:40px; border-radius:50%; border:none; background:rgba(255,255,255,0.12); color:#fff; font-size:22px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center;"
    >
      ✕
    </button>
    <div
      id="dby-lightbox-scroll"
      style="width:100%; height:100%; overflow:auto; display:flex; align-items:center; justify-content:center;"
    >
      <img
        id="dby-lightbox-img"
        src=""
        alt=""
        draggable="false"
        style="max-width:100%; max-height:100%; object-fit:contain; border-radius:8px; cursor:zoom-in; touch-action:none; user-select:none; -webkit-user-drag:none; -webkit-touch-callout:none;"
      />
    </div>
    <div
      id="dby-lightbox-hint"
      style="position:absolute; left:50%; bottom:18px; transform:translateX(-50%); font-size:12px; color:rgba(255,255,255,0.7); background:rgba(0,0,0,0.4); padding:6px 14px; border-radius:20px; pointer-events:none;"
    >
      Dodirni sliku za zumiranje
    </div>
  </div>
</BaseLayout>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('dby-lightbox');
    const lightboxImg = document.getElementById('dby-lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('dby-lightbox-close');
    const scrollWrap = document.getElementById('dby-lightbox-scroll');
    const hint = document.getElementById('dby-lightbox-hint');
    if (!lightbox || !lightboxImg || !closeBtn || !scrollWrap) return;

    let zoomed = false;
    const ZOOM_FACTOR = 2.4;

    function resetZoom() {
      lightboxImg!.style.maxWidth = '100%';
      lightboxImg!.style.maxHeight = '100%';
      lightboxImg!.style.width = '';
      lightboxImg!.style.cursor = 'zoom-in';
      scrollWrap!.style.alignItems = 'center';
      scrollWrap!.style.justifyContent = 'center';
      scrollWrap!.scrollTop = 0;
      scrollWrap!.scrollLeft = 0;
      zoomed = false;
      if (hint) hint.style.display = '';
    }

    function zoomAtPoint(clientX: number, clientY: number) {
      const containerRect = scrollWrap!.getBoundingClientRect();
      const imgRect = lightboxImg!.getBoundingClientRect();

      // Where on the (currently unzoomed) image did the user click, as a 0..1 fraction.
      const fx = (clientX - imgRect.left) / imgRect.width;
      const fy = (clientY - imgRect.top) / imgRect.height;

      const newWidth = imgRect.width * ZOOM_FACTOR;
      const newHeight = imgRect.height * ZOOM_FACTOR;

      // Lay the image out from the top-left so scrollLeft/scrollTop map directly to pixels.
      scrollWrap!.style.alignItems = 'flex-start';
      scrollWrap!.style.justifyContent = 'flex-start';
      lightboxImg!.style.maxWidth = 'none';
      lightboxImg!.style.maxHeight = 'none';
      lightboxImg!.style.width = `${newWidth}px`;
      lightboxImg!.style.cursor = 'grab';

      // Point the scroll position so the clicked spot stays under the cursor.
      scrollWrap!.scrollLeft = fx * newWidth - (clientX - containerRect.left);
      scrollWrap!.scrollTop = fy * newHeight - (clientY - containerRect.top);

      zoomed = true;
      if (hint) hint.style.display = 'none';
    }

    function toggleZoom(clientX: number, clientY: number) {
      if (!zoomed) {
        zoomAtPoint(clientX, clientY);
      } else {
        resetZoom();
      }
    }

    function open(src: string, alt: string) {
      lightboxImg!.src = src;
      lightboxImg!.alt = alt;
      resetZoom();
      lightbox!.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox!.style.display = 'none';
      lightboxImg!.src = '';
      resetZoom();
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const img = target.closest('.dby-lightbox-img') as HTMLImageElement | null;
      if (img) {
        open(img.src, img.alt || '');
      }
    });

    let dragging = false;
    let moved = false;
    let startX = 0;
    let startY = 0;
    let startScrollLeft = 0;
    let startScrollTop = 0;

    lightboxImg.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
      e.preventDefault();
      dragging = true;
      moved = false;
      startX = e.clientX;
      startY = e.clientY;
      startScrollLeft = scrollWrap!.scrollLeft;
      startScrollTop = scrollWrap!.scrollTop;
      if (zoomed) lightboxImg!.style.cursor = 'grabbing';
      (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
    });

    lightboxImg.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
      if (zoomed && moved) {
        scrollWrap!.scrollLeft = startScrollLeft - dx;
        scrollWrap!.scrollTop = startScrollTop - dy;
      }
    });

    function endDrag(e: PointerEvent) {
      if (!dragging) return;
      dragging = false;
      if (!moved) {
        // A tap/click without dragging: toggle zoom in/out at that point.
        toggleZoom(e.clientX, e.clientY);
      } else if (zoomed) {
        lightboxImg!.style.cursor = 'grab';
      }
    }

    lightboxImg.addEventListener('pointerup', endDrag);
    lightboxImg.addEventListener('pointercancel', endDrag);

    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    scrollWrap.addEventListener('click', (e) => {
      if (e.target === scrollWrap) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<script>
  async function copyText(url: string) {
    try {
      await navigator.clipboard.writeText(url);
    } catch (e) {
      const tmp = document.createElement('input');
      tmp.value = url;
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand('copy');
      document.body.removeChild(tmp);
    }
  }

  function initShareAndPrint() {
    const copyBtn = document.getElementById('dby-copy-link');
    const copyFeedback = document.getElementById('dby-copy-feedback');
    const printBtn = document.getElementById('dby-print-btn');
    const instagramBtn = document.getElementById('dby-share-instagram');

    copyBtn?.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      await copyText(url);
      if (copyFeedback) {
        copyFeedback.textContent = 'Link kopiran!';
        copyFeedback.style.display = 'inline';
        setTimeout(() => {
          copyFeedback!.style.display = 'none';
        }, 2000);
      }
    });

    instagramBtn?.addEventListener('click', async () => {
      const url = instagramBtn.getAttribute('data-url') || window.location.href;
      await copyText(url);
      if (copyFeedback) {
        copyFeedback.textContent = 'Link kopiran! Zalijepi ga u Instagram Story ili bio.';
        copyFeedback.style.display = 'inline';
        setTimeout(() => {
          copyFeedback!.style.display = 'none';
        }, 4000);
      }
      window.open('https://www.instagram.com/', '_blank', 'noopener,noreferrer');
    });

    printBtn?.addEventListener('click', () => {
      window.print();
    });
  }
  initShareAndPrint();
  document.addEventListener('astro:page-load', initShareAndPrint);
</script>
