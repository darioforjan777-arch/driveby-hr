---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Stranica nije pronađena">
  <div style="max-width:560px; margin:0 auto; padding:100px 20px; text-align:center;">
    <h1 style="font-size:32px; font-weight:800; margin:0 0 14px;">404 – stranica ne postoji</h1>
    <p style="font-size:15.5px; color:var(--text-muted); line-height:1.7; margin:0 0 24px;">Stranica koju tražite ne postoji ili je premještena.</p>
    <a href="/" style="display:inline-block; font-size:14px; font-weight:700; padding:12px 20px; border-radius:10px; background:var(--accent); color:#fff;">Natrag na naslovnicu</a>
  </div>
</BaseLayout>
